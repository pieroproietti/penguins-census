#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl stop penguins-census.service >/dev/null 2>&1 || true
            systemctl disable penguins-census.service >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
